{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "types": [],
    "rootDir": "src",
    "outDir": ".dts-tmp",
    "noEmitOnError": false
  },
  "include": ["src/**/*.ts"]
}
