{
  "name": "maypop-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "The browser SDK for apps running on Maypop.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilica-digital/maypop-sdk.git"
  },
  "homepage": "https://github.com/basilica-digital/maypop-sdk#readme",
  "bugs": {
    "url": "https://github.com/basilica-digital/maypop-sdk/issues"
  },
  "keywords": [
    "maypop",
    "sdk",
    "browser",
    "vite",
    "next.js",
    "rsbuild"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js",
      "default": "./dist/v1.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.ts",
      "import": "./dist/rsbuild.js",
      "default": "./dist/rsbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./contracts/*": "./contracts/*",
    "./source/runtime": "./src/runtime.ts",
    "./source/v1": "./src/v1.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "contracts",
    "dist",
    "src/runtime.ts",
    "src/v1.ts"
  ],
  "sideEffects": [
    "./src/runtime.ts",
    "./dist/v1.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "peerDependencies": {
    "@rsbuild/core": ">=1 <3",
    "next": ">=14 <17",
    "react": ">=18.2",
    "vite": ">=5 <9"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs dist",
    "build:prebuilt": "node build.mjs prebuilt",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@rsbuild/core": "2.2.8",
    "@types/node": "26.0.0",
    "@types/react": "19.2.6",
    "esbuild": "0.28.2",
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-test-renderer": "19.2.0",
    "replicache": "15.3.0",
    "typescript": "5.7.3",
    "vite": "8.3.0"
  }
}
